# ==========================================
# Choice FinX API Credentials (kkunal)
# ==========================================

# Your Vendor ID issued by Choice
CHOICE_VENDOR_ID=YOUR_VENDOR_ID

# Your long-lived API Key / JWT Bearer token from Choice FinX profile
CHOICE_API_KEY=YOUR_CHOICE_API_KEY

# Your registered mobile number (for automated TOTP login)
CHOICE_MOBILE_NO=YOUR_REGISTERED_MOBILE_NUMBER

# Choice API Base URL (optional - defaults to https://finxomne.choiceindia.com or https://finx.choiceindia.com)
CHOICE_BASE_URL=https://finx.choiceindia.com

# Target basket size (default is 6)
TARGET_BASKET_SIZE=6

# Capital allocation (in INR)
POSITION_SIZE=10000000
